# ========================================================
# AI Incident Triage Assistant - Environment Configuration
# ========================================================

# Enter your Google Gemini API Key below to activate cloud LLM mode.
# Get a free key at: https://aistudio.google.com/apikey
# If left blank, the system automatically runs in 100% offline Local RAG Mode (0 tokens).
GEMINI_API_KEY=your_gemini_api_key_here

# Desired Gemini Model Name:
# Recommended: gemini-3.8-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Port for local web dashboard and API (Default: 3000)
PORT=3000
